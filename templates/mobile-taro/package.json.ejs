{
  "name": "<%= useMonorepo ? 'web' : projectName %>",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Taro 跨端项目",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "<%= framework === 'react' ? 'React' : 'Vue3' %>"
  },
  "scripts": {
    "dev": "npm run dev:h5",
    "build": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "taro build --type h5 --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
<% if (useMonorepo) { -%>
    "<%= sharedPackageName %>": "workspace:*",
<% } -%>
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-harmony-hybrid": "4.2.1",
    "@tarojs/plugin-platform-jd": "4.2.1",
    "@tarojs/plugin-platform-qq": "4.2.1",
    "@tarojs/plugin-platform-swan": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
<% if (framework === 'react') { -%>
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/react": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
<% } else { -%>
    "@tarojs/plugin-framework-vue3": "4.2.1",
    "vue": "^3.5.13"<% if (uiLibrary === '@nutui/nutui') { -%>,
    "@nutui/nutui-taro": "^4.3.13"<% } -%>
<% } -%>
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
<% if (framework === 'react') { -%>
    "@babel/preset-react": "^7.24.1",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^4.3.4",
    "react-refresh": "^0.14.2",
<% } else { -%>
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
<% } -%>
<% if (framework === 'vue' && uiLibrary === '@nutui/nutui') { -%>
    "@tarojs/plugin-html": "4.2.1",
<% } -%>
    "@tarojs/cli": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "babel-preset-taro": "4.2.1",
    "postcss": "^8.4.38",
    "sass": "^1.75.0",
    "terser": "^5.30.4",
    "typescript": "~5.7.3",
    "vite": "^4.2.0"
  }
}
