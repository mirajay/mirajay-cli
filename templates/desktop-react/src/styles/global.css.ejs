@layer base {
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
<% if (uiLibrary !== 'shadcn-ui') { -%>
    color: #213547;
<% } -%>
  }
}

@layer components {
  .app-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem;
  }

  .app-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .app-main {
    display: flex;
    justify-content: center;
  }
}
