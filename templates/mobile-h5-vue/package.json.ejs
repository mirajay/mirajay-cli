{
  "name": "<%= useMonorepo ? 'web' : projectName %>",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
<% if (useTypeScript) { -%>
    "build": "vue-tsc -b && vite build",
<% } else { -%>
    "build": "vite build",
<% } -%>
    "preview": "vite preview"
  },
  "dependencies": {
<% if (useMonorepo) { -%>
    "<%= sharedPackageName %>": "workspace:*",
<% } -%>
    "vue": "^3.5.13",
<% if (uiLibrary === '@nutui/nutui') { -%>
    "@nutui/nutui": "^4.3.13",
<% } else { -%>
    "vant": "^4.9.17",
<% } -%>
    "vue-router": "^4.5.0",
    "amfe-flexible": "^2.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
<% if (useTypeScript) { -%>
    "typescript": "~5.7.3",
    "vue-tsc": "^2.2.4",
<% } -%>
    "vite": "^6.2.0",
    "postcss": "^8.5.3",
    "postcss-pxtorem": "^6.1.0",
    "autoprefixer": "^10.4.20"
<% if (cssFramework === 'tailwindcss') { -%>
    ,"tailwindcss": "^4.0.9",
    "@tailwindcss/vite": "^4.0.9"
<% } -%>
  }
}
