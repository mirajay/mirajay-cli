{
  "expo": {
    "name": "<%= projectName %>",
    "slug": "<%= projectName %>",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "<%= projectName %>",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"]
  }
}
