name: <%= projectName %>
description: Flutter 跨端应用
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.6.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
<% if (flutterStateManagement === 'Provider') { -%>
  provider: ^6.1.2
<% } else if (flutterStateManagement === 'Riverpod') { -%>
  flutter_riverpod: ^2.6.1
<% } else if (flutterStateManagement === 'Bloc') { -%>
  flutter_bloc: ^9.1.0
<% } -%>
  go_router: ^14.8.1
  dio: ^5.8.0
<% if (flutterInternationalization) { -%>
  intl: ^0.20.2
  flutter_localizations:
    sdk: flutter
<% } -%>

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true
<% if (flutterInternationalization) { -%>
  generate: true
<% } -%>
