import { StrictMode } from 'react'
import { createRoot } from 'react-dom/client'
import WujieReact from 'wujie-react'

const { setupApp, preloadApp } = WujieReact

setupApp({
  name: 'sub-app-react',
  url: 'http://localhost:5174',
  exec: true,
  alive: true,
  fetch: (url<% if (useTypeScript) { %>: RequestInfo | URL, options?: RequestInit<% } %>) =>
    window.fetch(url, { ...options, mode: 'cors' }),
})

preloadApp({ name: 'sub-app-react' })

export function App() {
  return (
    <StrictMode>
      <div style={{ padding: '2rem' }}>
        <h1><%= projectName %> - 无界微前端 (React 主应用)</h1>
        <p>请先启动示例子应用 dev 服务（默认 http://localhost:5174，建议同栈 React 项目）</p>
        <div style={{ border: '1px solid #ddd', borderRadius: '8px', marginTop: '1rem', width: '100%', height: '400px' }}>
          <WujieReact
            name="sub-app-react"
            url="http://localhost:5174"
            sync={true}
          />
        </div>
      </div>
    </StrictMode>
  )
}

createRoot(document.getElementById('root')<%= useTypeScript ? '!' : '' %>).render(<App />)
