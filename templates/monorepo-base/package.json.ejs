{
  "name": "<%= projectName %>",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"<% if (typeof mobilePlatform !== 'undefined' && mobilePlatform === 'taro') { %>,
    "dev:h5": "pnpm --filter web dev:h5",
    "dev:weapp": "pnpm --filter web dev:weapp",
    "dev:alipay": "pnpm --filter web dev:alipay",
    "dev:tt": "pnpm --filter web dev:tt",
    "dev:swan": "pnpm --filter web dev:swan",
    "dev:qq": "pnpm --filter web dev:qq",
    "dev:jd": "pnpm --filter web dev:jd",
    "dev:harmony-hybrid": "pnpm --filter web dev:harmony-hybrid",
    "build:h5": "pnpm --filter web build:h5",
    "build:weapp": "pnpm --filter web build:weapp",
    "build:alipay": "pnpm --filter web build:alipay",
    "build:tt": "pnpm --filter web build:tt",
    "build:swan": "pnpm --filter web build:swan",
    "build:qq": "pnpm --filter web build:qq",
    "build:jd": "pnpm --filter web build:jd",
    "build:harmony-hybrid": "pnpm --filter web build:harmony-hybrid"<% } else if (typeof mobilePlatform !== 'undefined' && mobilePlatform === 'uni-app') { %>,
    "dev:h5": "pnpm --filter web dev:h5",
    "dev:mp-weixin": "pnpm --filter web dev:mp-weixin",
    "dev:mp-alipay": "pnpm --filter web dev:mp-alipay",
    "dev:mp-toutiao": "pnpm --filter web dev:mp-toutiao",
    "dev:mp-baidu": "pnpm --filter web dev:mp-baidu",
    "dev:mp-qq": "pnpm --filter web dev:mp-qq",
    "dev:mp-jd": "pnpm --filter web dev:mp-jd",
    "dev:mp-kuaishou": "pnpm --filter web dev:mp-kuaishou",
    "dev:mp-lark": "pnpm --filter web dev:mp-lark",
    "build:h5": "pnpm --filter web build:h5",
    "build:mp-weixin": "pnpm --filter web build:mp-weixin",
    "build:mp-alipay": "pnpm --filter web build:mp-alipay",
    "build:mp-toutiao": "pnpm --filter web build:mp-toutiao",
    "build:mp-baidu": "pnpm --filter web build:mp-baidu",
    "build:mp-qq": "pnpm --filter web build:mp-qq",
    "build:mp-jd": "pnpm --filter web build:mp-jd",
    "build:mp-kuaishou": "pnpm --filter web build:mp-kuaishou",
    "build:mp-lark": "pnpm --filter web build:mp-lark"<% } %>
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@9.15.0"
}
