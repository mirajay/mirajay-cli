{
  "name": "<%= useMonorepo ? 'web' : projectName %>",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
<% if (useTypeScript) { -%>
    "build": "vue-tsc -b && vite build",
<% } else { -%>
    "build": "vite build",
<% } -%>
    "preview": "vite preview"
  },
  "dependencies": {
<% if (useMonorepo) { -%>
    "<%= sharedPackageName %>": "workspace:*",
<% } -%>
    "vue": "^3.5.13",
<% if (uiLibrary === 'element-plus') { -%>
    "element-plus": "^2.9.5",
<% } else if (uiLibrary === 'ant-design-vue') { -%>
    "ant-design-vue": "^4.2.6",
<% } else if (uiLibrary === 'naive-ui') { -%>
    "naive-ui": "^2.41.0",
<% } else if (uiLibrary === 'vuetify') { -%>
    "vuetify": "^3.8.0",
<% } else if (uiLibrary === 'primevue') { -%>
    "primevue": "^4.3.1",
    "@primevue/themes": "^4.3.1",
<% } -%>
    "vue-router": "^4.5.0",
    "pinia": "^3.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
<% if (useTypeScript) { -%>
    "typescript": "~5.7.3",
    "vue-tsc": "^2.2.4",
<% } -%>
    "vite": "^6.2.0"
<% if (cssFramework === 'tailwindcss') { -%>
    ,"tailwindcss": "^4.0.9",
    "@tailwindcss/vite": "^4.0.9",
    "postcss": "^8.5.3",
    "autoprefixer": "^10.4.20"
<% } else if (cssFramework === 'unocss') { -%>
    ,"unocss": "^66.0.0",
    "@unocss/reset": "^66.0.0"
<% } -%>
  }
}
