import { createApp } from 'vue'
import { createPinia } from 'pinia'
import App from './App.vue'
import router from './router'
<% if (uiLibrary === 'element-plus') { -%>
import ElementPlus from 'element-plus'
import 'element-plus/dist/index.css'
<% } else if (uiLibrary === 'ant-design-vue') { -%>
import Antd from 'ant-design-vue'
import 'ant-design-vue/dist/reset.css'
<% } else if (uiLibrary === 'naive-ui') { -%>
// Naive UI uses on-demand import via unplugin
<% } else if (uiLibrary === 'vuetify') { -%>
import 'vuetify/styles'
import { createVuetify } from 'vuetify'
import * as components from 'vuetify/components'
import * as directives from 'vuetify/directives'
<% } else if (uiLibrary === 'primevue') { -%>
import PrimeVue from 'primevue/config'
import Aura from '@primevue/themes/aura'
<% } -%>
<% if (cssFramework === 'tailwindcss') { -%>
import './styles/tailwind.css'
<% } else if (cssFramework === 'unocss') { -%>
import '@unocss/reset/tailwind.css'
import 'virtual:uno.css'
<% } -%>
import './styles/global.css'

const app = createApp(App)
const pinia = createPinia()

app.use(pinia)
app.use(router)
<% if (uiLibrary === 'element-plus') { -%>
app.use(ElementPlus)
<% } else if (uiLibrary === 'ant-design-vue') { -%>
app.use(Antd)
<% } else if (uiLibrary === 'vuetify') { -%>
const vuetify = createVuetify({ components, directives })
app.use(vuetify)
<% } else if (uiLibrary === 'primevue') { -%>
app.use(PrimeVue, { theme: { preset: Aura } })
<% } -%>

app.mount('#app')
