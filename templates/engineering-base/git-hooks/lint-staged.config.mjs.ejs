/** @type {import('lint-staged').Config} */
export default {
<% const appPath = typeof engineeringAppPath !== 'undefined' ? engineeringAppPath : (useMonorepo ? 'apps/web' : '.') -%>
<% const isWorkspace = appPath !== '.' -%>
<% const codeGlob = isWorkspace ? 'apps/**/*.{ts,tsx,vue,js,jsx}' : '*.{ts,tsx,vue,js,jsx}' -%>
<% const styleGlob = isWorkspace
  ? (framework === 'vue' ? 'apps/**/*.{css,scss,vue}' : 'apps/**/*.{css,scss}')
  : (framework === 'vue' ? '*.{css,scss,vue}' : '*.{css,scss}') -%>
<% const formatGlob = isWorkspace
  ? '{apps,packages}/**/*.{ts,tsx,vue,js,jsx,json,md,css,scss}'
  : '*.{ts,tsx,vue,js,jsx,json,md,css,scss}' -%>
<% const eslintConfig = isWorkspace ? ` --config ${appPath}/eslint.config.js` : '' -%>
<% const stylelintConfig = isWorkspace ? ` --config ${appPath}/stylelint.config.mjs` : '' -%>
<% if (engineering.eslint) { -%>
  '<%= codeGlob %>': ['eslint --fix<%= eslintConfig %>'],
<% } -%>
<% if (engineering.stylelint) { -%>
  '<%= styleGlob %>': ['stylelint --fix<%= stylelintConfig %>'],
<% } -%>
<% if (engineering.prettier) { -%>
  '<%= formatGlob %>': ['prettier --write'],
<% } -%>
<% if (engineering.spellcheck) { -%>
  '<%= isWorkspace ? '**/*.{ts,tsx,vue,js,jsx,md,json}' : '**/*.{ts,tsx,vue,js,jsx,md,json}' %>': ['cspell --no-must-find-files'],
<% } -%>
}
